# Copy this file to .env and replace every placeholder before starting Docker.
WEB_PORT=8080

DB_NAME=f1kd
DB_USER=f1kd_app
DB_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_ADMIN_EMAIL=Superadmin@gmail.com
DEFAULT_ADMIN_PASSWORD=replace-this-initial-password

MINIO_ROOT_USER=f1kd-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-storage-password
MINIO_BUCKET=f1kd-documents
MINIO_CONSOLE_PORT=9001

# EmailJS values are server-side only. Never add the private key to VITE_* variables.
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_CREDENTIALS_TEMPLATE_ID=your_credentials_template_id
EMAILJS_OTP_TEMPLATE_ID=your_otp_template_id
