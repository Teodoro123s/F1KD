# Copy to .env and update for your local environment (XAMPP)
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=f1kd
ENABLE_TEST_ROLE_SHORTCUTS=false
APP_URL=http://localhost:5173

# EmailJS credentials stay on the server. Rotate any private key exposed in screenshots.
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_CREDENTIALS_TEMPLATE_ID=your_credentials_template_id
EMAILJS_OTP_TEMPLATE_ID=your_otp_template_id

# Optional OpenAI-compatible endpoint for a self-hosted/private model (for example Ollama).
# The base URL should include /v1 and be reachable from the backend.
PROGRESS_REPORT_AI_BASE_URL=
PROGRESS_REPORT_AI_MODEL=
# Leave blank when the local model endpoint does not require authentication.
PROGRESS_REPORT_AI_API_KEY=
