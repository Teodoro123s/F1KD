# Copy to .env for running the backend outside Docker.
# The Docker Compose database is exposed on 127.0.0.1:3307.
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=f1kd_app
DB_PASSWORD=replace-with-the-root-env-db-password
DB_NAME=f1kd
DEFAULT_ADMIN_EMAIL=Superadmin@gmail.com
DEFAULT_ADMIN_PASSWORD=change-this-on-first-setup
# Set true only for an intentional recovery of a missing password hash.
SELF_HEAL_ADMIN_CREDENTIALS=false
