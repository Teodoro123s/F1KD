# Copy this file to .env and replace every placeholder before starting Docker Compose.
# Never commit .env or put production credentials in this example.

# Web application
WEB_PORT=5173
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# MariaDB
DB_NAME=f1kd
DB_USER=f1kd_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-a-different-unique-root-password

# MinIO object storage
MINIO_ROOT_USER=replace-with-a-unique-minio-username
MINIO_ROOT_PASSWORD=replace-with-a-unique-minio-password
MINIO_BUCKET=f1kd-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Required server signing secret. Use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional: bootstrap or recover a named Superadmin account; set both values together.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
SELF_HEAL_ADMIN_CREDENTIALS=false

# Check-up reminder schedule
CHECKUP_REMINDER_TIME=08:00
CHECKUP_REMINDER_TIMEZONE=Asia/Manila

# Optional EmailJS account email configuration
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_CREDENTIALS_TEMPLATE_ID=
EMAILJS_USER_TEMPLATE_ID=
EMAILJS_OTP_TEMPLATE_ID=

# Optional AI integration. Users provide their own provider API key in AI Settings.
PROGRESS_REPORT_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PROGRESS_REPORT_AI_MODEL=gemini-3.1-flash-lite
PROGRESS_REPORT_AI_API_KEY=
# Required for encrypted per-user AI keys; generate locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AI_SETTINGS_ENCRYPTION_KEY=

# Optional TLS override (docker-compose.tls.yml)
HTTPS_PORT=443
TLS_CERTIFICATE_PATH=
TLS_PRIVATE_KEY_PATH=
